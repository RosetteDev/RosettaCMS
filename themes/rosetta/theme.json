{
    "name": "Rosetta Default",
    "slug": "rosetta",
    "version": "1.0.0",
    "description": "A modern, responsive default theme for Rosetta CMS",
    "author": "Rosetta CMS Team",
    "author_url": "https://rosetta-cms.com",
    "screenshot": "screenshot.png",
    "preview_url": null,
    "supports": {
        "features": ["menu", "widgets", "customizer", "thumbnails"],
        "layouts": ["one-column", "two-column", "three-column"],
        "post_types": ["post", "page"]
    },
    "settings": {
        "primary_color": "#3b82f6",
        "secondary_color": "#6b7280",
        "accent_color": "#10b981",
        "background_color": "#ffffff",
        "text_color": "#1f2937",
        "font_family": "system-ui, sans-serif",
        "container_width": "1200px",
        "body_font_size": "16px",
        "line_height": "1.6",
        "block_gap": "2rem",
        "section_padding": "3rem"
    },
    "assets": {
        "css": ["css/style.css"],
        "js": ["js/main.js"]
    },
    "views": {
        "layouts": ["layouts/app"],
        "pages": ["pages/home", "pages/about", "pages/contact", "pages/single"],
        "posts": ["posts/single", "posts/archive", "posts/category", "posts/tag"],
        "partials": ["partials/header", "partials/footer", "partials/navigation"]
    }
}
