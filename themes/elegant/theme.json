{
    "name": "Elegant Pro",
    "slug": "elegant",
    "version": "1.0.0",
    "description": "Sophisticated, professional theme for businesses",
    "author": "Rosetta CMS Team",
    "author_url": "https://rosetta-cms.com",
    "screenshot": "screenshot.png",
    "preview_url": null,
    "supports": {
        "features": ["menu", "widgets", "customizer", "thumbnails"],
        "layouts": ["one-column", "two-column", "three-column", "sidebar-left", "sidebar-right"],
        "post_types": ["post", "page"]
    },
    "settings": {
        "primary_color": "#1e3a8a",
        "secondary_color": "#64748b",
        "accent_color": "#d97706",
        "background_color": "#fafafa",
        "text_color": "#1f2937",
        "font_family": "Georgia, 'Times New Roman', serif",
        "container_width": "1100px"
    },
    "assets": {
        "css": ["css/style.css"],
        "js": ["js/main.js"]
    },
    "views": {
        "layouts": ["layouts/app"],
        "pages": ["pages/home", "pages/about", "pages/contact", "pages/single"],
        "posts": ["posts/single", "posts/archive", "posts/category", "posts/tag"],
        "partials": ["partials/header", "partials/footer", "partials/navigation"]
    }
}
